# Copy this file to .env and fill in your key to run with a real LLM.
ANTHROPIC_API_KEY=your-key-here

# Model used by the agents.
TRIAGE_MODEL=claude-sonnet-4-6

# Set to "true" to run the whole graph with canned responses and NO API key,
# useful for demos, CI, and interviews where you don't want to burn tokens.
TRIAGE_MOCK_LLM=false
